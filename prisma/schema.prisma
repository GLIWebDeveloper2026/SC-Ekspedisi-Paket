generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================================
// ENUM
// ==========================================================

enum Role {
  OWNER
  ADMIN_PUSAT
  PETUGAS_LOKET
  KEPALA_GUDANG
  KURIR
}

enum ServiceType {
  REGULER
  KILAT
  KARGO
}

enum CustodyEventType {
  DIBUAT_DI_LOKET
  MASUK_KARUNG
  KELUAR_KARUNG
  MASUK_GUDANG
  KELUAR_GUDANG
  DISERAHKAN_KE_KURIR
  DIOPER_KE_KURIR_LAIN
  DELIVERY_ATTEMPT
  TERKIRIM
  RETUR_KE_GUDANG
  RETUR_KE_PENGIRIM
}

enum DeliveryResult {
  BERHASIL
  GAGAL
  DITITIP_PIHAK_KETIGA
}

enum RemitStatus {
  PENDING
  REMITTED
  DISCREPANCY
}

enum AdjustmentType {
  REWEIGH_DIFF
  KOREKSI_LAIN
}

enum ReturnBorneBy {
  PENGIRIM
  PERUSAHAAN
}

// ==========================================================
// MASTER DATA
// ==========================================================

model District {
  id             String          @id @default(cuid())
  name           String
  isZonaJauh     Boolean         @default(false)
  agents         Agent[]
  zoneSurcharges ZoneSurcharge[]
  createdAt      DateTime        @default(now())
}

model Agent {
  id         String   @id @default(cuid())
  name       String
  districtId String
  district   District @relation(fields: [districtId], references: [id])
  users      User[]
  resi       Resi[]   @relation("ResiOriginAgent")
  createdAt  DateTime @default(now())
}

model Warehouse {
  id        String    @id @default(cuid())
  name      String
  couriers  Courier[]
  users     User[]
  createdAt DateTime  @default(now())
}

model Courier {
  id               String            @id @default(cuid())
  name             String
  warehouseId      String?
  warehouse        Warehouse?        @relation(fields: [warehouseId], references: [id])
  deliveryAttempts DeliveryAttempt[]
  codCollections   CodCollection[]
  createdAt        DateTime          @default(now())
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role
  agentId      String?
  agent        Agent?      @relation(fields: [agentId], references: [id])
  warehouseId  String?
  warehouse    Warehouse?  @relation(fields: [warehouseId], references: [id])
  createdAt    DateTime    @default(now())
}

// ==========================================================
// TARIF (VERSIONED — INTI JAWABAN PERTANYAAN WAJIB #1)
// ==========================================================

model TariffRule {
  id                String          @id @default(cuid())
  serviceType       ServiceType
  ratePerKg         Decimal         @db.Decimal(12, 2)
  volumetricDivisor Decimal         @db.Decimal(12, 2)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  zoneSurcharges    ZoneSurcharge[]
  resi              Resi[]
  createdAt         DateTime        @default(now())

  @@index([serviceType, effectiveFrom, effectiveTo])
}

model ZoneSurcharge {
  id              String     @id @default(cuid())
  tariffRuleId    String
  tariffRule      TariffRule @relation(fields: [tariffRuleId], references: [id])
  districtId      String
  district        District   @relation(fields: [districtId], references: [id])
  surchargeAmount Decimal    @db.Decimal(12, 2)

  @@unique([tariffRuleId, districtId])
}

// ==========================================================
// RESI (INTI TRANSAKSI)
// ==========================================================

model Resi {
  id                    String      @id @default(cuid())
  noResi                String      @unique
  originAgentId         String
  originAgent           Agent       @relation("ResiOriginAgent", fields: [originAgentId], references: [id])
  destinationDistrictId String
  senderName            String
  senderPhone           String
  recipientName         String
  recipientAddress      String
  serviceType           ServiceType

  beratAktualKg   Decimal @db.Decimal(10, 2)
  panjangCm       Decimal @db.Decimal(10, 2)
  lebarCm         Decimal @db.Decimal(10, 2)
  tinggiCm        Decimal @db.Decimal(10, 2)
  beratTertagihKg Decimal @db.Decimal(10, 2)

  // Snapshot — permanen, tidak berubah walau tariff_rules dapat versi baru
  tariffRuleId String
  tariffRule   TariffRule @relation(fields: [tariffRuleId], references: [id])
  biayaDasar   Decimal    @db.Decimal(12, 2)
  biayaZona    Decimal    @db.Decimal(12, 2)
  totalOngkir  Decimal    @db.Decimal(12, 2)

  isCod    Boolean  @default(false)
  nilaiCod Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  custodyEvents    PackageCustodyEvent[]
  sackItems        SackItem[]
  deliveryAttempts DeliveryAttempt[]
  codCollection    CodCollection?
  paymentItems     PaymentTransactionItem[]
  adjustments      ResiAdjustment[]
  returns          Return[]
}

// ==========================================================
// KUSTODI PAKET (EVENT LOG — INTI JAWABAN PERTANYAAN WAJIB #2)
// ==========================================================

model Sack {
  id              String     @id @default(cuid())
  originInfo      String
  destinationInfo String
  items           SackItem[]
  createdAt       DateTime   @default(now())
}

model SackItem {
  sackId String
  resiId String
  sack   Sack   @relation(fields: [sackId], references: [id])
  resi   Resi   @relation(fields: [resiId], references: [id])

  @@id([sackId, resiId])
}

model PackageCustodyEvent {
  id          String            @id @default(cuid())
  resiId      String
  resi        Resi              @relation(fields: [resiId], references: [id])
  eventType   CustodyEventType
  fromEntity  String?
  toEntity    String?
  actorUserId String?
  notes       String?
  evidenceUrl String?
  timestamp   DateTime          @default(now())

  @@index([resiId, timestamp])
}

// ==========================================================
// DELIVERY ATTEMPT (JAWABAN PERTANYAAN WAJIB #3)
// ==========================================================

model DeliveryAttempt {
  id             String         @id @default(cuid())
  resiId         String
  resi           Resi           @relation(fields: [resiId], references: [id])
  courierId      String
  courier        Courier        @relation(fields: [courierId], references: [id])
  attemptNumber  Int
  result         DeliveryResult
  recipientName  String?
  thirdPartyFlag Boolean        @default(false)
  thirdPartyName String?
  proofPhotoUrl  String?
  attemptedAt    DateTime       @default(now())
}

// ==========================================================
// COD (JAWABAN PERTANYAAN WAJIB #4)
// ==========================================================

model CodCollection {
  id                String      @id @default(cuid())
  resiId            String      @unique
  resi              Resi        @relation(fields: [resiId], references: [id])
  courierId         String
  courier           Courier     @relation(fields: [courierId], references: [id])
  collectedAmount   Decimal     @db.Decimal(12, 2)
  collectedAt       DateTime    @default(now())
  komisiPercent     Decimal     @db.Decimal(5, 2)
  expectedRemit     Decimal     @db.Decimal(12, 2)
  remitStatus       RemitStatus @default(PENDING)
  remitAmount       Decimal?    @db.Decimal(12, 2)
  remittedAt        DateTime?
  discrepancyAmount Decimal?    @db.Decimal(12, 2)
}

// ==========================================================
// PEMBAYARAN BATCH (JAWABAN PERTANYAAN WAJIB #5)
// ==========================================================

model PaymentTransaction {
  id          String                   @id @default(cuid())
  payerName   String
  totalAmount Decimal                  @db.Decimal(12, 2)
  paymentDate DateTime                 @default(now())
  method      String
  items       PaymentTransactionItem[]
}

model PaymentTransactionItem {
  id                   String              @id @default(cuid())
  paymentTransactionId String
  paymentTransaction   PaymentTransaction  @relation(fields: [paymentTransactionId], references: [id])
  resiId               String
  resi                 Resi                @relation(fields: [resiId], references: [id])
  amountAllocated      Decimal             @db.Decimal(12, 2)
}

// ==========================================================
// KOREKSI & RETUR
// ==========================================================

model ResiAdjustment {
  id             String         @id @default(cuid())
  resiId         String
  resi           Resi           @relation(fields: [resiId], references: [id])
  adjustmentType AdjustmentType
  amount         Decimal        @db.Decimal(12, 2)
  reason         String
  createdAt      DateTime       @default(now())
}

model Return {
  id                 String        @id @default(cuid())
  resiId             String
  resi               Resi          @relation(fields: [resiId], references: [id])
  reason             String
  returnShippingCost Decimal       @db.Decimal(12, 2)
  borneBy            ReturnBorneBy
  initiatedAt        DateTime      @default(now())
}
