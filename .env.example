# Salin file ini menjadi .env dan isi nilai sesuai project Supabase kamu.
# JANGAN commit file .env asli.

# Supabase Postgres — gunakan connection pooler (port 6543) untuk query runtime,
# dan direct connection (port 5432) khusus untuk migrasi Prisma.
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"

# NextAuth (Auth.js)
NEXTAUTH_SECRET="ganti-dengan-random-string"
AUTH_SECRET="ganti-dengan-random-string"
AUTH_TRUST_HOST=true
# NEXTAUTH_URL: JANGAN di-set di lokal — dengan AUTH_TRUST_HOST=true, Auth.js
# menyimpulkan host dari tiap request (penting kalau kamu test PWA kurir dari HP
# lewat IP LAN, karena hostnya beda dari localhost). Di production (Vercel),
# set NEXTAUTH_URL ke domain deploy-nya (mis. https://nama-project.vercel.app).

# Supabase Storage (upload bukti foto delivery)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_STORAGE_BUCKET="bukti-pengiriman"
